# Copy this file to .env.local (already gitignored via *.local) and fill in.
# Vite only exposes vars prefixed with VITE_ to the browser.

# WalletConnect Cloud project id. Free at https://cloud.reown.com
# Required for the WalletConnect QR flow. Injected wallets (MetaMask) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Dedicated RPC URLs. Optional, but public RPCs rate-limit hard.
# Free Alchemy keys at https://dashboard.alchemy.com — one app per network.
VITE_SEPOLIA_RPC_URL=
VITE_MAINNET_RPC_URL=
